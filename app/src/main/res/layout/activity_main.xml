<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:id="@+id/rootLayout"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="horizontal"
android:background="#070A10"
android:padding="12dp"
android:weightSum="100">
<!-- 1. DOCK LATÉRAL GAUCHE STYLE CARPLAY -->
<LinearLayout
android:id="@+id/carplayDock"
android:layout_width="82dp"
android:layout_height="match_parent"
android:orientation="vertical"
android:gravity="center_horizontal"
android:background="@drawable/dock_bg"
android:paddingTop="14dp"
android:paddingBottom="14dp"
android:paddingStart="8dp"
android:paddingEnd="8dp"
android:layout_marginEnd="14dp">
<!-- Heure + Réseau -->
<LinearLayout
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:orientation="vertical"
android:gravity="center">
<TextView
android:id="@+id/tvClock"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:background="#FF9F0A"
android:paddingStart="10dp"
android:paddingEnd="10dp"
android:paddingTop="3dp"
android:paddingBottom="3dp"
android:text="15:23"
android:textColor="#000000"
android:textSize="13sp"
android:textStyle="bold" />
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginTop="4dp"
android:text="4G • GPS"
android:textColor="#8E8E93"
android:textSize="10sp"
android:textStyle="bold" />
</LinearLayout>
<View
android:layout_width="1dp"
android:layout_height="0dp"
android:layout_weight="1" />
<!-- 4 Icônes Principales -->
<LinearLayout
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:orientation="vertical"
android:gravity="center">
<TextView
android:id="@+id/btnNavCarplay"
android:layout_width="52dp"
android:layout_height="52dp"
android:gravity="center"
android:background="#1AFFFFFF"
android:text="📱"
android:textSize="22sp"
android:layout_marginBottom="12dp" />
<TextView
android:id="@+id/btnNavMaps"
android:layout_width="52dp"
android:layout_height="52dp"
android:gravity="center"
android:background="#1AFFFFFF"
android:text="🗺️"
android:textSize="22sp"
android:layout_marginBottom="12dp" />
<TextView
android:id="@+id/btnNavRadio"
android:layout_width="52dp"
android:layout_height="52dp"
android:gravity="center"
android:background="#1AFFFFFF"
android:text="📻"
android:textSize="22sp"
android:layout_marginBottom="12dp" />
<TextView
android:id="@+id/btnNavPhone"
android:layout_width="52dp"
android:layout_height="52dp"
android:gravity="center"
android:background="#1AFFFFFF"
android:text="📞"
android:textSize="22sp" />
</LinearLayout>
<View
android:layout_width="1dp"
android:layout_height="0dp"
android:layout_weight="1" />
<!-- Bouton Diagnostic / Tiroir d'apps en bas -->
<TextView
android:id="@+id/btnOpenDiag"
android:layout_width="46dp"
android:layout_height="46dp"
android:gravity="center"
android:background="#14FFFFFF"
android:text="⠿"
android:textColor="#FFFFFF"
android:textSize="22sp" />
</LinearLayout>
<!-- 2. GRANDE CARTE CENTRALE : VIDÉO 360° + VUE DE HAUT MULTI-OUVRANTS (60%) -->
<FrameLayout
android:id="@+id/stageCard"
android:layout_width="0dp"
android:layout_height="match_parent"
android:layout_weight="60"
android:layout_marginEnd="14dp"
android:background="@drawable/dock_bg"
android:clipChildren="true"
android:clipToPadding="true">
<!-- Lecteur Vidéo 360° Sans Flash Noir (TextureView) -->
<TextureView
android:id="@+id/carTextureView"
android:layout_width="match_parent"
android:layout_height="match_parent" />
<!-- Superposition Vue de Haut avec Halo Rouge (DoorPanelView) -->
<com.outlander.launcher.DoorPanelView
android:id="@+id/doorPanelView"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:alpha="0" />
<!-- Vignette radiale sombre pour fondre les bords -->
<View
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@drawable/scrim"
android:clickable="false" />
<!-- Pilule Statut CANbus en haut à gauche -->
<TextView
android:id="@+id/tvCanbusBanner"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_gravity="top|start"
android:layout_margin="16dp"
android:background="#D9121824"
android:paddingStart="14dp"
android:paddingEnd="14dp"
android:paddingTop="6dp"
android:paddingBottom="6dp"
android:text="● OUTLANDER SPORT SE • FERMÉ"
android:textColor="#30D158"
android:textSize="12sp"
android:textStyle="bold" />
<!-- Badge Vitesse circulaire en haut à droite (Style CarPlay Maps) -->
<LinearLayout
android:layout_width="64dp"
android:layout_height="64dp"
android:layout_gravity="top|end"
android:layout_margin="16dp"
android:background="@drawable/dock_bg"
android:gravity="center"
android:orientation="vertical">
<TextView
android:id="@+id/tvSpeedVal"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="0"
android:textColor="#FFFFFF"
android:textSize="20sp"
android:textStyle="bold" />
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="km/h"
android:textColor="#8E8E93"
android:textSize="10sp" />
</LinearLayout>
<!-- Barre d'indication en bas de la carte -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_gravity="bottom"
android:layout_margin="14dp"
android:orientation="horizontal"
android:gravity="center_vertical">
<TextView
android:id="@+id/tvScrubHint"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_weight="1"
android:text="👆 Glisser pour tourner à 360°"
android:textColor="#8E8E93"
android:textSize="11sp" />
<TextView
android:id="@+id/tvLightsBadge"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:background="#B3000000"
android:paddingStart="10dp"
android:paddingEnd="10dp"
android:paddingTop="4dp"
android:paddingBottom="4dp"
android:text="💡 Phares : OFF"
android:textColor="#8E8E93"
android:textSize="11sp" />
</LinearLayout>
</FrameLayout>
<!-- 3. COLONNE WIDGETS DROITE (40%) -->
<LinearLayout
android:layout_width="0dp"
android:layout_height="match_parent"
android:layout_weight="40"
android:orientation="vertical"
android:weightSum="100">
<!-- WIDGET HAUT : CAPTEURS D'OUVRANTS SIMPLESOFT RP5-MT-002 -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="0dp"
android:layout_weight="52"
android:layout_marginBottom="14dp"
android:background="@drawable/dock_bg"
android:orientation="vertical"
android:padding="14dp">
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:layout_marginBottom="10dp">
<TextView
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_weight="1"
android:text="CAPTEURS CANBUS (RP5-MT-002)"
android:textColor="#8E8E93"
android:textSize="11sp"
android:textStyle="bold" />
<TextView
android:id="@+id/btnCloseAll"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Tout fermer 🔒"
android:textColor="#0A84FF"
android:textSize="11sp"
android:textStyle="bold" />
</LinearLayout>
<!-- Grille 3x2 des 6 ouvrants -->
<GridLayout
android:layout_width="match_parent"
android:layout_height="match_parent"
android:columnCount="3"
android:rowCount="2"
android:alignmentMode="alignMargins"
android:useDefaultMargins="true">
<Button
android:id="@+id/pillFl"
android:layout_width="0dp"
android:layout_height="0dp"
android:layout_columnWeight="1"
android:layout_rowWeight="1"
android:background="#14FFFFFF"
android:text="AV. G\nFermée"
android:textAllCaps="false"
android:textColor="#FFFFFF"
android:textSize="11sp" />
<Button
android:id="@+id/pillFr"
android:layout_width="0dp"
android:layout_height="0dp"
android:layout_columnWeight="1"
android:layout_rowWeight="1"
android:background="#14FFFFFF"
android:text="AV. D\nFermée"
android:textAllCaps="false"
android:textColor="#FFFFFF"
android:textSize="11sp" />
<Button
android:id="@+id/pillHood"
android:layout_width="0dp"
android:layout_height="0dp"
android:layout_columnWeight="1"
android:layout_rowWeight="1"
android:background="#14FFFFFF"
android:text="Capot\nFermé"
android:textAllCaps="false"
android:textColor="#FFFFFF"
android:textSize="11sp" />
<Button
android:id="@+id/pillRl"
android:layout_width="0dp"
android:layout_height="0dp"
android:layout_columnWeight="1"
android:layout_rowWeight="1"
android:background="#14FFFFFF"
android:text="AR. G\nFermée"
android:textAllCaps="false"
android:textColor="#FFFFFF"
android:textSize="11sp" />
<Button
android:id="@+id/pillRr"
android:layout_width="0dp"
android:layout_height="0dp"
android:layout_columnWeight="1"
android:layout_rowWeight="1"
android:background="#14FFFFFF"
android:text="AR. D\nFermée"
android:textAllCaps="false"
android:textColor="#FFFFFF"
android:textSize="11sp" />
<Button
android:id="@+id/pillTrunk"
android:layout_width="0dp"
android:layout_height="0dp"
android:layout_columnWeight="1"
android:layout_rowWeight="1"
android:background="#14FFFFFF"
android:text="Coffre\nFermé"
android:textAllCaps="false"
android:textColor="#FFFFFF"
android:textSize="11sp" />
</GridLayout>
</LinearLayout>
<!-- WIDGET BAS : AUDIO & RÉSEAU DE BORD -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="0dp"
android:layout_weight="48"
android:background="@drawable/dock_bg"
android:orientation="vertical"
android:padding="14dp"
android:gravity="center_vertical">
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="AUDIO &amp; RÉSEAU BORD"
android:textColor="#8E8E93"
android:textSize="11sp"
android:textStyle="bold" />
<LinearLayout
android:layout_width="match_parent"
android:layout_height="0dp"
android:layout_weight="1"
android:gravity="center"
android:orientation="vertical">
<TextView
android:layout_width="54dp"
android:layout_height="54dp"
android:background="#FF375F"
android:gravity="center"
android:text="ılı"
android:textColor="#FFFFFF"
android:textSize="24sp"
android:textStyle="bold" />
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginTop="6dp"
android:text="ZhangXun CarPlay / Bluetooth"
android:textColor="#FFFFFF"
android:textSize="14sp"
android:textStyle="bold" />
</LinearLayout>
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal">
<TextView
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_weight="1"
android:text="🔋 Batterie : 14.2 V"
android:textColor="#30D158"
android:textSize="12sp"
android:textStyle="bold" />
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="📡 B9320B • RP5"
android:textColor="#8E8E93"
android:textSize="12sp" />
</LinearLayout>
</LinearLayout>
</LinearLayout>
</LinearLayout>
